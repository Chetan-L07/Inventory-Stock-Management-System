# Database Configuration (MySQL / PostgreSQL / SQLite)
# If DB_USER and DB_NAME are not set, the app will automatically use local SQLite
DB_USER=root
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventory_db

# Flask App Configuration
FLASK_ENV=production
SECRET_KEY=your_production_secret_key

# Frontend Streamlit Configuration
FLASK_API_URL=http://127.0.0.1:5001/api/v1
