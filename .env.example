# =========================================================
# DATABASE CONFIGURATION
# =========================================================
# Option 1: Direct Cloud Database URL (Supabase, Neon, Render PostgreSQL, TiDB, Aiven, Railway)
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 2: MySQL (Individual variables)
# DB_USER=root
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=inventory_db

# Option 3: Local SQLite (Leave DATABASE_URL and DB_USER blank to auto-use Database/inventory.db)


# =========================================================
# FLASK BACKEND CONFIGURATION
# =========================================================
FLASK_ENV=production
SECRET_KEY=your_production_secret_key_here
PORT=5001


# =========================================================
# FRONTEND STREAMLIT CONFIGURATION
# =========================================================
# Points the frontend to the deployed backend URL
FLASK_API_URL=http://127.0.0.1:5001/api/v1
# Example for deployed backend:
# FLASK_API_URL=https://your-flask-backend.onrender.com/api/v1
